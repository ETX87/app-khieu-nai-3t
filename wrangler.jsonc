{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiepnhan",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "khieu-nai-db", "database_id": "fef4e5cf-fdda-4441-8383-41ec20f00fa0", "migrations_dir": "migrations" }],
  // Service Binding tới Worker "dvbh" (RPC nội bộ qua Cloudflare) - fetch() thẳng URL bị chặn lỗi
  // 1042 (chống SSRF, Worker-gọi-Worker cùng tài khoản) - xem lib/dvbhClient.ts + linh-kien-app.
  "services": [{ "binding": "DVBH_SERVICE", "service": "dvbh", "remote": true }],
  "vars": {
    "BOOTSTRAP_ADMIN_EMAIL": "smarttrade.vp@gmail.com",
    "GOOGLE_REDIRECT_URI": "https://tiepnhan.dichvu3t.workers.dev/api/auth/callback",
    "FRONTEND_URL": "https://tiepnhan.dichvu3t.workers.dev",
    "DVBH_API_BASE": "https://dvbh.dichvu3t.workers.dev",
    // Chuong thong bao (Web Push) - public var an toan de commit; private key la secret rieng
    // (wrangler secret put VAPID_SERVER_PRIVATE_KEY), xem backend/src/lib/webPush.ts.
    "VAPID_SUBJECT": "mailto:smarttrade.vp@gmail.com",
    "VAPID_SERVER_PUBLIC_KEY": "BNb-Kn7OehFHI9VhDrisdJY6xoJ92EjrYp4-24TMo493zWY1L6lQmDFJXAizfz_dKCQoZGIhEFy2rWJyGzM5yqc",
    // Tra cuu ID LADA qua he thong noi bo cho nhan vien - token la secret rieng
    // (wrangler secret put CENTER3T_API_TOKEN), xem backend/src/lib/center3tClient.ts.
    "CENTER3T_API_BASE": "https://center.dichvu3t.com"
  }
}
